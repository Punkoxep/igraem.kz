datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String         @id @default(uuid())
  iin               String         @unique
  phone_number      String         @unique
  full_name         String
  birth_date        DateTime
  gender            String         // 'male' | 'female'
  role              String         @default("client") // 'client' | 'admin'
  is_blocked        Boolean        @default(false)
  is_banned         Boolean        @default(false)
  banned_until      DateTime?
  password_hash     String
  email                       String?        @unique
  pending_email               String?        @map("pending_email")
  email_verification_code     String?        @map("email_verification_code")
  email_verification_expires  DateTime?      @map("email_verification_expires")
  reset_password_token        String?        @map("reset_password_token")
  reset_password_expires      DateTime?      @map("reset_password_expires")
  avatar_url                  String?
  notify_30min           Boolean        @default(false)
  push_subscription      String?        // JSON string of PushSubscription
  created_at             DateTime       @default(now())

  hostedBookings Booking[]     @relation("HostBookings")
  bookingGuests  BookingGuest[]
  lockLogs       LockLog[]
  userBans       UserBan[]
  reviews        Review[]
  issues         IssueReport[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model Ground {
  id                    String     @id @default(uuid())
  name                  String
  type                  String     // 'football' | 'volleyball' | 'basketball'
  address               String
  operating_schedule    String     // e.g. "08:00 - 23:00"
  cost_per_hour         Float
  latitude              Float      @default(50.060371)
  longitude             Float      @default(72.993374)
  allowed_radius_meters Int        @default(50)
  qr_code_token         String     @unique
  ttlock_lock_id        String
  ttlock_mac_address    String?
  is_school_court       Boolean    @default(true)
  school_hours_start    String     @default("08:00")
  school_hours_end      String     @default("15:00")
  school_days           String     @default("MON_FRI")
  rating                Float      @default(0.0)
  created_at            DateTime   @default(now())

  gateways   Gateway[]
  bookings   Booking[]
  lockLogs   LockLog[]
  dailyStats VenueDailyStats[]
  userBans   UserBan[]
  reviews    Review[]
  issues     IssueReport[]

  @@map("grounds")
}

model Review {
  id         String   @id @default(uuid())
  ground_id  String
  ground     Ground   @relation(fields: [ground_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  rating     Int      // 1 to 5 stars
  comment    String?
  created_at DateTime @default(now())

  @@map("reviews")
}

model Gateway {
  id                String   @id @default(uuid())
  ground_id         String
  ground            Ground   @relation(fields: [ground_id], references: [id], onDelete: Cascade)
  gateway_name      String
  ttlock_gateway_id String   @unique
  status            String   @default("online") // 'online' | 'offline'
  last_ping_at      DateTime @default(now())
  created_at        DateTime @default(now())

  logs GatewayStatusLog[]

  @@map("gateways")
}

model Booking {
  id                     String         @id @default(uuid())
  ground_id              String
  ground                 Ground         @relation(fields: [ground_id], references: [id], onDelete: Cascade)
  host_user_id           String
  host_user              User           @relation("HostBookings", fields: [host_user_id], references: [id], onDelete: Cascade)
  booking_date           String         // 'YYYY-MM-DD'
  start_time             String         // 'HH:mm'
  end_time               String         // 'HH:mm'
  status                 String         @default("confirmed") // 'pending' | 'confirmed' | 'cancelled' | 'cancelled_no_show' | 'completed'
  payment_status         String         @default("paid") // 'unpaid' | 'paid' | 'refunded'
  is_door_opened         Boolean        @default(false)
  is_reminder_sent       Boolean        @default(false)
  total_price            Float
  invite_token           String         @unique @default(uuid())
  is_looking_for_players Boolean        @default(false)
  needed_players_count   Int            @default(0)
  auto_approve_players   Boolean        @default(false)
  created_at             DateTime       @default(now())

  guests       BookingGuest[]
  lockLogs     LockLog[]
  joinRequests JoinRequest[]
  issues       IssueReport[]

  @@map("bookings")
}

model BookingGuest {
  id            String   @id @default(uuid())
  booking_id    String
  booking       Booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type          String   // 'invited' | 'spontaneous_check_in'
  status        String   @default("approved") // 'approved' | 'pending'
  checked_in_at DateTime @default(now())
  created_at    DateTime @default(now())

  @@unique([booking_id, user_id])
  @@map("booking_guests")
}

model LockLog {
  id          String   @id @default(uuid())
  booking_id  String?
  booking     Booking? @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ground_id   String
  ground      Ground   @relation(fields: [ground_id], references: [id], onDelete: Cascade)
  method      String   // 'app_button' | 'qr_code'
  unlock_type String   // 'online_cloud' | 'offline_passcode' | 'offline_ekey'
  success     Boolean
  details     String?
  created_at  DateTime @default(now())

  @@map("lock_logs")
}

model GatewayStatusLog {
  id           String   @id @default(uuid())
  gateway_id   String
  gateway      Gateway  @relation(fields: [gateway_id], references: [id], onDelete: Cascade)
  status       String   // 'online' | 'offline'
  response_raw String?
  checked_at   DateTime @default(now())

  @@map("gateway_status_logs")
}

model JoinRequest {
  id         String   @id @default(uuid())
  booking_id String
  booking    Booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  user_iin   String
  user_name  String
  user_phone String
  status     String   @default("PENDING") // 'PENDING' | 'APPROVED' | 'REJECTED'
  created_at DateTime @default(now())

  @@map("join_requests")
}

model VenueDailyStats {
  id                   String   @id @default(uuid())
  ground_id            String
  ground               Ground   @relation(fields: [ground_id], references: [id], onDelete: Cascade)
  date                 String   // 'YYYY-MM-DD'
  total_bookings       Int      @default(0)
  unique_players_count Int      @default(0)
  peak_hours_occupancy Float    @default(0.0)
  off_peak_occupancy   Float    @default(0.0)
  average_team_size    Float    @default(0.0)
  created_at           DateTime @default(now())

  @@unique([ground_id, date])
  @@map("venue_daily_stats")
}

model UserBan {
  id           String    @id @default(uuid())
  user_id      String
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ground_id    String?
  ground       Ground?   @relation(fields: [ground_id], references: [id], onDelete: SetNull)
  reason       String
  banned_until DateTime
  is_resolved  Boolean   @default(false)
  created_at   DateTime  @default(now())

  @@map("user_bans")
}

model IssueReport {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ground_id  String
  ground     Ground   @relation(fields: [ground_id], references: [id], onDelete: Cascade)
  booking_id String?
  booking    Booking? @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  message    String
  status     String   @default("NEW") // 'NEW' | 'IN_PROGRESS' | 'RESOLVED'
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("issue_reports")
}

model PushSubscription {
  id         String   @id @default(uuid())
  user_id    String   @map("user_id")
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  created_at DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}


